# ==============================================================================
# Konfigurasi Production SI MADU PELAWAN (Kabupaten Bangka)
# Sesuai Standar REMEDIATION_PLAN.md Prioritas P0.5
# ==============================================================================

APP_NAME="SI MELATI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://simadupelawan.bangka.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# Keamanan Log
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database Production (Gunakan user MySQL dengan privilege terbatas)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simadu_pelawan_prod
DB_USERNAME=simadu_prod_user
DB_PASSWORD=

# Session Hardening
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Storage & Private Files
# File laporan & bukti koreksi disimpan secara private di disk local (storage/app/private)
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

BCRYPT_ROUNDS=12
